{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "Verbose": false
  },
  "Inventory": {
    "CollectionIntervalSeconds": 3600,
    "EnableParallelCollection": true
  },
  "Upload": {
    "Endpoint": "http://localhost:5000/api/inventory",
    "MaxBatchSize": 10,
    "RetryCount": 3,
    "RetryDelaySeconds": 30,
    "BackoffMultiplier": 2.0
  },
  "Spool": {
    "DirectoryPath": "./spool",
    "MaxQueueSize": 1000
  }
}
